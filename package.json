{
  "name": "millipede",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:academy": "pnpm --filter @millipede/academy dev",
    "build:academy": "pnpm --filter @millipede/academy build",
    "dev:radar": "pnpm --filter @millipede/radar dev",
    "build:radar": "pnpm build:wasm && pnpm --filter @millipede/radar build",
    "build:wasm": "pnpm --filter @millipede/redact-wasm build",
    "build:widgets": "pnpm --filter @millipede/lesson-widgets build",
    "evals:run": "python3 evals/run_evals.py",
    "evals:write-metrics": "python3 evals/run_evals.py --write-metrics",
    "test:e2e": "pnpm --filter @millipede/e2e test",
    "test:e2e:ui": "pnpm --filter @millipede/e2e test:ui",
    "compose:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "compose:down": "docker compose -f infra/docker/docker-compose.yml down",
    "demo:tmux": "bash scripts/millipede-demo-tmux.sh",
    "millipede-demo": "bash scripts/millipede-demo-tmux.sh",
    "millipede-commit-push": "bash scripts/millipede-commit-push.sh",
    "ingestion:dev": "cargo run -p millipede-ingestion",
    "analyzer:dev": "cargo run -p millipede-analyzer",
    "gateway:dev": "cargo run -p millipede-gateway",
    "llm-worker:dev": "bash -c 'cd services/llm-worker && (test -d .venv || python3 -m venv .venv) && .venv/bin/pip install -q -e . && .venv/bin/python -m millipede_llm_worker.main'"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
