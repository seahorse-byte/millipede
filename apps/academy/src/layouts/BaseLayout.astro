---
interface Props {
  title: string;
  activeNav?: "home" | "lessons";
}

const { title, activeNav = "lessons" } = Astro.props;
import "@millipede/lesson-widgets/styles.css";
import "../styles/academy.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Millipede Academy — interactive DevSecOps learning" />
    <meta name="theme-color" content="#080b10" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Millipede Academy</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a href="/" class="site-brand">
          <span class="site-brand-mark" aria-hidden="true">M</span>
          <span>Millipede Academy</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/" class:list={{ "is-active": activeNav === "home" }}>Lessons</a>
          <a
            href="https://github.com/seahorse-byte/millipede"
            rel="noopener noreferrer"
            target="_blank">GitHub</a
          >
        </nav>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <p>
          Learn fundamentals · Ship Team Radar · <a href="/">Book 0 — Foundations</a>
        </p>
      </footer>
    </div>
  </body>
</html>
