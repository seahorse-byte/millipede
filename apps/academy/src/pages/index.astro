---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { bookLabel, groupLessonsByBook } from "../data/books";

const lessons = await getCollection("lessons");
const byBook = groupLessonsByBook(lessons);
const books = [...byBook.keys()].sort((a, b) => a - b);
---

<BaseLayout title="Millipede Academy" activeNav="home">
  <section class="hero">
    <p class="hero-eyebrow">DevSecOps learning loop</p>
    <h1>Learn the stack. Ship the radar.</h1>
    <p class="hero-lead">
      Interactive lessons that teach bits, HTTP, and security primitives — mapped directly to the
      Team Radar pipeline you build in the monorepo.
    </p>
    <div class="hero-stats">
      <span class="hero-stat"><strong>{lessons.length}</strong> lessons</span>
      <span class="hero-stat"><strong>{books.length}</strong> books in progress</span>
      <span class="hero-stat"><strong>Interactive</strong> widgets + labs</span>
    </div>
  </section>

  {
    books.map((book) => (
      <section class="book-section">
        <h2>{bookLabel(book)}</h2>
        <p class="book-meta">
          {
            book === 0
              ? "Bits → packets → client/server → browser → CORS → TLS → capstone"
              : book === 1
                ? "Event loop → Promises → Rust ownership → SolidJS + TanStack"
                : book === 2
                  ? "Event-driven → Kafka → Postgres/Redis → Compose → Pages deploy"
                  : book === 3
                    ? "Zero-trust → JWT → mTLS → WASM redaction → BFF deep-dive"
                    : book === 4
                      ? "Build-along: monorepo → Axum → Kafka → SQLx → Redis → tracing"
                      : book === 5
                        ? "Gateway JWT/mTLS → Python LLM → enriched Kafka → analyzer"
                        : book === 6
                          ? "Radar: SolidJS → TanStack Query/Router → WASM → SSE live feed"
                          : "Coming soon"
          }
        </p>
        <ul class="lesson-grid">
          {
            (byBook.get(book) ?? []).map((lesson) => (
              <li class="lesson-card">
                <a href={`/lessons/${lesson.slug}/`}>
                  <span class="lesson-id">{lesson.data.id}</span>
                  <span class="lesson-title">{lesson.data.title}</span>
                  <span class="lesson-meta">{lesson.data.duration_min ?? 30} min</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    ))
  }
</BaseLayout>
