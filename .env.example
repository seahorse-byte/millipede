# Copy to .env.local — never commit tokens.

# Ingestion endpoint (default: local stack)
INGESTION_URL=http://127.0.0.1:8081

# GitHub — Settings → Developer settings → Personal access tokens
# Classic: `repo` scope. Fine-grained: pull request read on target repos.
GITHUB_TOKEN=

# GitLab — Preferences → Access tokens (`read_api`)
GITLAB_TOKEN=
GITLAB_HOST=https://gitlab.com

# Jira Cloud — id.atlassian.com → Security → API tokens
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SITE=https://yourorg.atlassian.net

# Slack — app OAuth bot token (`xoxb-...`); bot must be in allowlisted channels
SLACK_BOT_TOKEN=

# Optional: connector watch interval (minutes)
CONNECTOR_POLL_MINUTES=5
